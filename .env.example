# CopyPaste environment variables
# Copy this file to .env.local and fill in real values.

# MongoDB Atlas connection string (free tier M0)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syncnote?retryWrites=true&w=majority
MONGODB_URI=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Cloudinary (images only) ------------------------------------------------
# Images go to Cloudinary because it resizes/re-encodes at delivery time.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is used to build delivery URLs in the browser.
# The API key/secret stay server-side: uploads are signed by /api/upload-sign.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare R2 (all non-image files) -------------------------------------
# The bucket stays PRIVATE. Do not enable the Public Development URL or a custom
# domain — uploads use presigned PUTs and downloads go through
# /api/files/[noteId], which checks note ownership before redirecting to a
# short-lived signed URL.
#
# Account ID: shown in the bucket's S3 API endpoint
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
R2_ACCOUNT_ID=
R2_BUCKET=copypaste

# R2 dashboard -> API -> Manage API tokens -> Create Account API token
# Permission: "Object Read & Write", scoped to the copypaste bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: max upload size in bytes. Defaults to 104857600 (100MB).
# R2_MAX_FILE_BYTES=104857600
